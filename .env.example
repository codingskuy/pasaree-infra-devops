# Salin ke `.env` (diabaikan git). JANGAN isi nilai nyata di berkas ini.
# Daftar lengkap dan pemilik secret: docs/deploy.md

# Postgres lokal (DB `pasaree`, tidak dibagi dengan divisi lain)
POSTGRES_USER=pasaree
POSTGRES_PASSWORD=ganti-saya
DB_HOST_PORT=5433
# Untuk menjalankan backend di luar compose (cargo run):
DATABASE_URL=postgres://pasaree:ganti-saya@localhost:5433/pasaree

# Autentikasi
JWT_AUD=pasaree
JWT_SECRET=ganti-saya-minimal-32-karakter

# Service key Lumbung (proksi payout/rekonsiliasi); kosong di lokal
LUMBUNG_SERVICE_KEY=

# Web
PASAREE_API_BASE_URL=http://localhost:8101
